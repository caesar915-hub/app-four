# Hermes AI assistant docs (business strategy, ASO, branding, etc.)
# These are generated by the AI assistant and should not be tracked
docs/hermes/

# Xcode
#
build/
DerivedData/
*.hmap
*.ipa
*.playground/
xcuserdata/

# Swift Package Manager
#
.build/
.swiftpm/

# Stray compiled module artifacts (never track build output)
*.swiftmodule

# Downloaded ML model dumps (spikes) — hundreds of MB, must never be tracked
spikes/flan-t5-summarizer/

# OS X
#
.DS_Store
*.swp
*.lock

# Gemini CLI
#
.agents/
.gemini/
memory/
# …but the Spec Kit constitution lives under .specify/memory/ and MUST be tracked
# (it gates every spec/plan). The bare `memory/` above would otherwise swallow it.
!.specify/memory/
!.specify/memory/**

# Claude Code local config, hooks & installed skills — not app source
# Ignore everything inside .claude/ except commands/ (project slash commands belong in the repo)
.claude/settings.json
.claude/settings.local.json
.claude/worktrees/
.claude/todos/
.claude/stats/

# Obsidian vault config (this repo doubles as an Obsidian vault; notes are the .md files)
.obsidian/

# Local design reference screen recordings (any location)
*.MP4
*.mp4
*.mov
*.MOV

# Scratch design drafts (e.g. .tmp-listen-v1.html)
.tmp-*
.gstack/

