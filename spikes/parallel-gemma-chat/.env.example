# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Host port the Open WebUI is published on (gated by the GCloud firewall allowlist).
WEBUI_PORT=8080

# Stable session-signing key so logins survive restarts.
# Generate one: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Admin account bootstrapped on first startup (first user = admin, signup then closes).
WEBUI_ADMIN_EMAIL=you@example.com
WEBUI_ADMIN_PASSWORD=change-me-strong
